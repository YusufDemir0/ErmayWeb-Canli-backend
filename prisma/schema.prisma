datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// ENUMLAR
// ----------------------------------------------------

enum AdminRole {
  ADMIN
  STAFF
}

enum RequestStatus {
  NEW
  CONTACTED
  STORE_VISIT_SCHEDULED
  AWAITING_PAYMENT
  PAID_OFFLINE
  COMPLETED
  CANCELLED
  SPAM
  EXPIRED
}

enum RequestPreference {
  WHATSAPP
  STORE_VISIT
}

enum PaymentChannel {
  WHATSAPP_TRANSFER
  IN_STORE
}

enum ErpSyncStatus {
  PENDING
  IN_PROGRESS
  SYNCED
  FAILED
}

// ----------------------------------------------------
// KULLANICI & YÖNETİM
// ----------------------------------------------------

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(STAFF)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_users")
}

// ----------------------------------------------------
// KATALOG & ÜRÜNLER
// ----------------------------------------------------

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id              String    @id @default(uuid())
  categoryId      String
  category        Category  @relation(fields: [categoryId], references: [id])
  name            String
  slug            String    @unique
  description     String    @default("")
  material        String    @default("")
  dimensions      String    @default("")
  widthCm         Int?
  depthCm         Int?
  heightCm        Int?
  drawerCount     Int?      @default(0)
  unitCount       Int?      @default(1)
  
  price           Decimal   @db.Decimal(12, 2)
  originalPrice   Decimal?  @db.Decimal(12, 2)
  vatRate         Decimal   @default(0.20) @db.Decimal(4, 2)
  
  stock           Int       @default(0)
  inStock         Boolean   @default(false)
  leadTimeDays    Int?      @default(15)
  
  image           String    @default("")
  images          String[]  @default([])
  features        String[]  @default([])
  colors          String[]  @default([])
  salesCount      Int       @default(0)
  setPieces       Json      @default("[]") // [{ title, dimensions?, pieceProductId? }]
  badge           String?
  
  // ERP Entegrasyon Alanları
  erpItemId       String    @unique
  erpItemCode     String?
  isPublished     Boolean   @default(false)
  lastSyncedAt    DateTime?
  erpMissingSince DateTime?
  archivedAt      DateTime?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  requestItems    OrderRequestItem[]

  @@index([isPublished, categoryId])
  @@index([isPublished, createdAt(sort: Desc)])
  @@index([inStock, isPublished])
  @@map("products")
}

// ----------------------------------------------------
// SİPARİŞ TALEBİ (ORDER REQUEST)
// ----------------------------------------------------

model OrderRequest {
  id               String            @id @default(uuid())
  code             String            @unique // Müşteri kodu: WEB-YYMM-XXXX
  publicToken      String            @unique @default(uuid())
  idempotencyKey   String?           @unique
  
  status           RequestStatus     @default(NEW)
  preference       RequestPreference
  preferredStoreId String?
  preferredStore   Store?            @relation(fields: [preferredStoreId], references: [id])
  
  customerName     String
  customerPhone    String
  customerEmail    String?
  city             String
  district         String?
  addressLine      String?
  note             String?
  
  subtotal         Decimal           @db.Decimal(12, 2)
  itemCount        Int
  
  kvkkNoticeAckAt  DateTime
  marketingConsent Boolean           @default(false)
  
  paymentChannel   PaymentChannel?
  
  // ERP Outbox & Senkronizasyon
  erpSyncStatus    ErpSyncStatus     @default(PENDING)
  erpSaleId        String?
  erpSaleCode      String?
  erpAttempts      Int               @default(0)
  erpNextAttemptAt DateTime?         @default(now())
  erpLastError     String?
  
  assignedToId     String?
  closedAt         DateTime?
  anonymizedAt     DateTime?
  
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  items            OrderRequestItem[]
  events           OrderRequestEvent[]

  @@index([status, createdAt(sort: Desc)])
  @@index([erpSyncStatus, erpNextAttemptAt])
  @@map("order_requests")
}

model OrderRequestItem {
  id              String       @id @default(uuid())
  requestId       String
  request         OrderRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  
  productId       String
  product         Product      @relation(fields: [productId], references: [id])
  
  productNameSnap String
  erpItemCodeSnap String?
  colorKey        String?
  colorLabel      String?
  
  unitPriceSnap   Decimal      @db.Decimal(12, 2)
  quantity        Int
  lineTotal       Decimal      @db.Decimal(12, 2)

  @@index([requestId])
  @@index([productId])
  @@map("order_request_items")
}

model OrderRequestEvent {
  id         String         @id @default(uuid())
  requestId  String
  request    OrderRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  
  type       String         // STATUS_CHANGE | NOTE | ERP_SYNCED | ERP_FAILED | WEBHOOK
  fromStatus RequestStatus?
  toStatus   RequestStatus?
  actorId    String?
  note       String?
  createdAt  DateTime       @default(now())

  @@index([requestId, createdAt])
  @@map("order_request_events")
}

// ----------------------------------------------------
// MAĞAZALAR, İLETİŞİM & CMS
// ----------------------------------------------------

model Store {
  id          String         @id @default(uuid())
  name        String
  city        String
  district    String?
  address     String
  phone       String
  email       String?
  hours       String?
  image       String?
  mapUrl      String?
  sortOrder   Int            @default(0)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  requests    OrderRequest[]

  @@index([city, isActive])
  @@map("stores")
}

model ContactMessage {
  id        String    @id @default(uuid())
  name      String
  phone     String
  email     String?
  subject   String
  message   String
  createdAt DateTime  @default(now())
  handledAt DateTime?

  @@map("contact_messages")
}

model CmsBlock {
  id        String   @id @default(uuid())
  key       String   @unique
  content   Json
  updatedAt DateTime @updatedAt

  @@map("cms_blocks")
}

model BlogPost {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  summary     String?
  content     String    @db.Text
  coverImage  String?
  category    String?   @default("Dekorasyon & Tasarım")
  tags        String[]  @default([])
  author      String    @default("Ermay Mobilya Mimari Ekibi")
  readTimeMin Int       @default(4)
  isPublished Boolean   @default(true)
  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([isPublished, publishedAt(sort: Desc)])
  @@map("blog_posts")
}
